{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama C++",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen-36": {
          "name": "Qwen-3.6 35B-A3B Q6_K-GGUF",
          "limit": {
            "context": 131072,
            "output": 12288
          }
        }
      }
    }
  },
  "references": {
    "External Library: NoxLib": {
        "path": "../STLibs-Nox-Library",
        "description": "External SillyTavern library extension dependency. Use for NoxLib implementation details."
    },
    "Extension Target: SillyTavern": {
        "repository": "SillyTavern/SillyTavern",
        "branch": "release",
        "description": "The web app this extension project targets. Use for API details."
    }
  },
  "permission": {
    "lsp": "deny",
    "bash": "ask",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "list": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "read": {
        "*": "ask",
        "tests/**": "allow"
    },
    "edit": {
        "*": "deny",
        "tests/**": "allow"
    },
    "grep": {
        "*": "ask",
        "tests/**": "allow"
    },
    "glob": {
        "*": "ask",
        "tests/**": "allow"
    }
  }
}
